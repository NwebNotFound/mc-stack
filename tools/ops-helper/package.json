{
  "name": "ops-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Privileged ops executor for hermes-mcp: speaks to a docker-socket-filter over TCP and runs only fixed allowlisted argv lists.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
