{
  "name": "hermes-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server (Streamable HTTP) that manages the Hermes agents through the Hermes gateway.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "4.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
