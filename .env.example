# Copy only when creating a new setup; do not overwrite an existing .env.
# Empty means: newest stable Minecraft version supported by Paper.
MINECRAFT_VERSION=
# Generate a cryptographically random password before starting.
RCON_PASSWORD=
# Optional tunnels stay disabled unless their Compose profile is selected.
SECRET_KEY=
TUNNEL_TOKEN=
# Vor Erststart zuf?llig und ausreichend lang setzen; danach nicht ohne DB-Migration ?ndern.
CRAFTCORE_DB_PASSWORD=
LUCKPERMS_DB_USER=luckperms
LUCKPERMS_DB_PASSWORD=

# Zentraler Modus fuer den Dev-Reset: dev, online oder wartung.
# SERVER_MODE=dev (historisch; Servermodus steht in MariaDB)

# PvP host service
PVP_HOST_TOKEN=
PVP_HOST_PORT=
PVP_HOST_BIND=
CRAFTCORE_PVP_DB_PASSWORD=

# hermes-mcp (tools/hermes-mcp) - remote MCP server for the Hermes agents.
# Bearer token for the Claude clients; comma separated for rotation (new,old).
# This is the READ-ONLY level: it can call the T0 ops tools.
HERMES_MCP_TOKEN=
# Second token level (>= 24 chars, openssl rand -hex 32). A caller that presents
# this instead gets the T1 ops tools; the T2 tools (game-server restarts, plugin
# deploys) additionally require the local listener. Unset = T1/T2 are refused for
# everyone (fail closed). Never send it through the tunnel.
HERMES_MCP_OPS_TOKEN=
# Local-only listener that serves T2. Published on 127.0.0.1 ONLY, and the tunnel
# must never point at it (it points at HERMES_MCP_PORT / 8765).
HERMES_MCP_OPS_PORT=8767
HERMES_MCP_OPS_LOCKOUT_AFTER=3
# JSON map profile -> that profile's API_SERVER_KEY (stored in profiles/<name>/.env).
HERMES_PROFILE_KEYS=
HERMES_GATEWAY_URL=http://host.docker.internal:8642
HERMES_MCP_PUBLIC_URL=https://mcp.nwebnotfound.dev
HERMES_MCP_ALLOWED_HOSTS=mcp.nwebnotfound.dev,localhost,127.0.0.1,hermes-mcp
# Token of the existing Cloudflare tunnel that already serves mcp.nwebnotfound.dev.
MCP_TUNNEL_TOKEN=

# ops-helper (tools/ops-helper) - privileged ops executor for hermes-mcp.
# Shared secret between hermes-mcp and ops-helper; >= 24 chars (openssl rand -hex 32).
# Without it the helper refuses to start and the ops tools are not advertised.
OPS_HELPER_TOKEN=
OPS_HELPER_URL=http://ops-helper:8766
# Global T2 arm switch (game-server restarts, plugin deploys). mcp.nwebnotfound.dev
# is ALREADY live behind the bearer token (Cloudflare Access only covers /admin on
# the website), so the real gate here is the second token + the local listener.
# Keep "false" until you have decided to hand out that token.
# Note: the T2 actions are disabled in config/ops-allowlist.json anyway (the socket
# proxy denies the POST/exec they need), so arming alone does not enable them.
OPS_ARMED=false
# Kill switch: "true" (or a file data/ops-helper/DISABLED) refuses everything above T0.
OPS_DISABLED=false

