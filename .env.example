# Copy only when creating a new setup; do not overwrite an existing .env.
# Empty means: newest stable Minecraft version supported by Paper.
MINECRAFT_VERSION=
# Generate a cryptographically random password before starting.
RCON_PASSWORD=
# Optional tunnels stay disabled unless their Compose profile is selected.
SECRET_KEY=
TUNNEL_TOKEN=
# Vor Erststart zuf?llig und ausreichend lang setzen; danach nicht ohne DB-Migration ?ndern.
CRAFTCORE_DB_PASSWORD=
LUCKPERMS_DB_USER=luckperms
LUCKPERMS_DB_PASSWORD=

# Zentraler Modus fuer den Dev-Reset: dev, online oder wartung.
# SERVER_MODE=dev (historisch; Servermodus steht in MariaDB)

# PvP host service
PVP_HOST_TOKEN=
PVP_HOST_PORT=
PVP_HOST_BIND=
CRAFTCORE_PVP_DB_PASSWORD=

# hermes-mcp (tools/hermes-mcp) - remote MCP server for the Hermes agents.
# Bearer token for the Claude clients; comma separated for rotation (new,old).
HERMES_MCP_TOKEN=
# JSON map profile -> that profile's API_SERVER_KEY (stored in profiles/<name>/.env).
HERMES_PROFILE_KEYS=
HERMES_GATEWAY_URL=http://host.docker.internal:8642
HERMES_MCP_PUBLIC_URL=https://mcp.nwebnotfound.dev
HERMES_MCP_ALLOWED_HOSTS=mcp.nwebnotfound.dev,localhost,127.0.0.1,hermes-mcp
# Only needed once the dedicated mcp tunnel exists in Cloudflare.
MCP_TUNNEL_TOKEN=

